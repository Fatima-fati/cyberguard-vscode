          "project",
          "generated_at",
          "policy",
          "status",
          "exit_decision",
          "exit_code",
          "analysis",
          "counts",
          "counts_by_area",
          "conditions",
          "reasons",
          "incomplete_areas",
          "unsupported_languages",
          "vulnerability_provider_status",
          "vulnerability_check_conclusive",
          "blocking_findings",
          "requires_ai",
          "requires_wazuh"
        ],
        "forbidden": [
          "score",
          "security_score",
          "grade",
          "rating",
          "risk_score",
          "evidence",
          "root_hash",
          "workspace_path",
          "secret",
          "token",
          "password"
        ]
      }
    }
  },
  "models": {
