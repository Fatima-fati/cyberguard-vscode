# ---------- Application ----------
APP_NAME=Wazuh Supervision

# Interface d'ecoute. Deux modes, et le choix est une decision de securite.
#
#   DEVELOPPEMENT LOCAL (defaut)
#     API_HOST=127.0.0.1
#     Le backend n'est joignable que depuis cette machine. C'est le mode
#     prevu pour l'extension VS Code : elle tourne sur le meme poste.
#
#   DEPLOIEMENT DISTANT
#     API_HOST=0.0.0.0
#     Le backend devient joignable depuis le reseau. A ne faire que derriere
#     un reverse proxy TLS, avec AGENT_AUTH_ENABLED=true et CORS_ORIGINS
#     restreint aux origines reellement attendues. Le backend detient des
#     identifiants et diffuse des extraits de code : l'exposer au reseau ne
#     doit jamais etre un effet de bord.
#
# Le demarrage annonce le mode retenu dans les journaux.
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# ---------- Authentification locale de l'extension ----------
# Le backend n'a qu'un appelant legitime : l'extension de cet utilisateur.
# Un jeton local partage ecarte les autres processus de la machine.
#
# Laisse actif. Le desactiver rend les routes sensibles — analyse, findings,
# contexte de projet, flux temps reel — appelables par n'importe quel
# processus local.
AGENT_AUTH_ENABLED=true

# Jeton impose par l'environnement (conteneur, service gere ailleurs).
# VIDE = le backend genere le sien au demarrage et l'ecrit dans le fichier
# ci-dessous, que l'extension relit automatiquement. C'est le cas normal en
# developpement : ne rien mettre ici.
AGENT_AUTH_TOKEN=

# Emplacement du fichier de jeton.
# VIDE = ~/.wazuh-security/agent-token, donc HORS du depot. Ne le deplacez
# pas dans le projet : un secret range dans l'arborescence versionnee finit
# commite ou partage avec le dossier.
AGENT_TOKEN_PATH=

# ---------- Wazuh Manager API ----------
WAZUH_API_URL=https://localhost:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=

# ---------- Enrolement des agents (Ajouter un serveur) ----------
# Adresse que les AGENTS utilisent pour joindre le manager (ports 1514/1515).
# Elle est independante de WAZUH_API_URL (port 55000) et n'en est JAMAIS
# deduite : 127.0.0.1 conviendrait a l'API mais serait inutilisable depuis un
# serveur distant. Renseignez une adresse joignable DEPUIS vos serveurs :
#   - poste de dev  : l'IP LAN de la machine  (ex. 192.168.11.144)
#   - entreprise    : le nom DNS du manager   (ex. wazuh-manager.company.local)
#                     ou son IP               (ex. 10.20.30.10)
# Laisse vide, "Ajouter un serveur" repond 503 avec un message expliquant
# quoi renseigner : aucune commande d'installation fausse n'est generee.
WAZUH_MANAGER_ADDRESS=
WAZUH_ENROLLMENT_PORT=1515
WAZUH_AGENT_PORT=1514
# Version et depot des paquets agent utilises dans les instructions generees
WAZUH_AGENT_VERSION=4.14.6
WAZUH_PACKAGES_BASE_URL=https://packages.wazuh.com/4.x

# ---------- Wazuh Indexer (alertes) ----------
INDEXER_URL=https://localhost:9200
INDEXER_USER=admin
INDEXER_PASSWORD=
INDEXER_INDEX=wazuh-alerts-4.x-*

# ---------- TLS ----------
# false pour les certificats auto-signes de l'environnement de test
VERIFY_SSL=false

# ---------- Reseau / timeouts ----------
CONNECT_TIMEOUT_SECONDS=5
REQUEST_TIMEOUT_SECONDS=15
AGENTS_LIMIT=500
# Marge de renouvellement anticipe du JWT et TTL de repli
TOKEN_LEEWAY_SECONDS=60
TOKEN_DEFAULT_TTL_SECONDS=900

# ---------- Surveillance ----------
# Intervalle du poller, en secondes
POLL_INTERVAL=10
# Nombre d'alertes remontees par cycle
ALERT_FETCH_SIZE=50
# Niveau a partir duquel une alerte est consideree comme critique (e-mail, Discord)
CRITICAL_LEVEL=10
# Niveau a partir duquel une alerte genere une notification (page
# Notifications, notification systeme du navigateur et flux SSE).
# Ce seuil ne depend pas de l'agent IA : il fonctionne meme sans OPENAI_API_KEY.
NOTIFY_LEVEL=10
# Delai minimal entre deux notifications pour un meme agent + meme regle.
# Une autre regle, un autre serveur ou une severite qui s'aggrave passent
# toujours ; les repetitions sont regroupees (compteur d'occurrences).
NOTIFY_COOLDOWN=300
# Chevauchement temporel : evite de perdre une alerte indexee en retard
POLL_OVERLAP_SECONDS=30
# Fenetre consultee au tout premier demarrage (aucun curseur en base)
INITIAL_LOOKBACK_SECONDS=300
# Identifiants gardes en memoire pour le dedoublonnage rapide
DEDUPE_CACHE_SIZE=2000

# ---------- Agent IA (OpenAI) ----------
# La cle reste cote backend : jamais dans React, jamais dans les logs
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=900
# Analyse automatique des nouvelles alertes par le poller
AI_ANALYSIS_ENABLED=false
# Niveau Wazuh minimum pour declencher une analyse automatique (limite le cout)
AI_ANALYSIS_MIN_LEVEL=7
# Analyses simultanees maximum
AI_MAX_CONCURRENCY=2
# Fenetre (heures) de mesure de la repetition d'une alerte
AI_REPETITION_WINDOW_HOURS=24

# ---------- Notifications IA (alertes HIGH / CRITICAL) ----------
AI_HIGH_NOTIFICATION_ENABLED=true
AI_CRITICAL_NOTIFICATION_ENABLED=true
# Delai minimal entre deux notifications pour un meme serveur + incident
AI_NOTIFICATION_COOLDOWN=300

# ---------- Remediation assistee ----------
AI_REMEDIATION_ENABLED=true
# Une correction n'est jamais appliquee sans confirmation explicite
AI_REMEDIATION_REQUIRE_CONFIRMATION=true
AI_REMEDIATION_BACKUP=true
AI_REMEDIATION_MAX_FILE_SIZE=1000000
# Racine autorisee pour l'ecriture. Vide = aucune ecriture possible : le
# backend ne peut pas modifier un fichier situe sur un serveur distant.
AI_REMEDIATION_ROOT=

# ---------- Temps reel (SSE) ----------
# Battement de coeur envoye aux navigateurs connectes
SSE_HEARTBEAT_SECONDS=15
# Taille de la file par client (au-dela, les evenements les plus vieux sautent)
SSE_QUEUE_SIZE=100
# Nombre maximum de navigateurs connectes simultanement
SSE_MAX_CLIENTS=50
# Delai de reconnexion suggere au navigateur (millisecondes)
SSE_RETRY_MS=3000
# Alertes rejouees au maximum apres une reconnexion (Last-Event-ID)
SSE_REPLAY_LIMIT=50

# ---------- Base de donnees ----------
DATABASE_PATH=data/alerts.db

# ---------- Notifications e-mail ----------
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# ---------- Notifications Discord ----------
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=

# ---------- Analyse de code (extension VS Code) ----------
# Detection deterministe des vulnerabilites dans le code envoye par
# l'extension. Ne coute rien et ne depend d'aucun service externe.
CODE_ANALYSIS_ENABLED=true
# Enrichissement des findings par le modele. Reste false tant que la
# phase 3 n'est pas livree : aucun code n'est envoye a OpenAI.
CODE_AI_ENRICHMENT_ENABLED=false
# Taille maximale acceptee par POST /api/code/scan (octets).
CODE_MAX_CONTENT_BYTES=400000
# Plafond de findings par scan et par page de resultats.
CODE_MAX_FINDINGS_PER_SCAN=100
CODE_FINDINGS_PAGE_SIZE=100

# ---------- Contexte de projet (extension VS Code) ----------
# L'extension decouvre le projet localement et soumet des METADONNEES
# (chemin relatif, taille, empreinte). Aucun contenu de fichier n'est
# transmis, et le contenu des fichiers sensibles n'est jamais lu.
#
# Plafond de fichiers indexes. Au-dela, l'index est tronque et la
# troncature est ANNONCEE dans la vue : afficher une couverture partielle
# comme complete serait un mensonge de securite.
PROJECT_MAX_INDEXED_FILES=20000
# Nombre maximum de fichiers remontes par liste (manifestes, config,
# sensibles) dans le contexte renvoye a l'extension.
PROJECT_MAX_LISTED_FILES=200

# ---------- Securite projet : secrets, dependances, vulnerabilites ----------
# AUCUN de ces trois moteurs n'appelle Wazuh. Ils fonctionnent avec le
# Manager et l'Indexer completement arretes.
#
# La DETECTION de secrets tourne dans l'extension, sur le poste : lire un
# fichier pour y chercher un secret est une operation locale. Le backend ne
# recoit que des constats et des preuves EXPURGEES (« sk-proj-******** »),
# qu'il reexpurge avant de les ecrire. Aucune valeur de secret n'est jamais
# stockee ni journalisee.
SECRET_DETECTION_ENABLED=true
# Plafond serveur de signalements par projet. Quand il mord, la troncature
# est ANNONCEE : un decompte plafonne presente comme complet serait un
# mensonge de securite.
SECRET_MAX_FINDINGS=500

# L'inventaire des dependances lit les manifestes et les lockfiles. Il
# n'INSTALLE et n'EXECUTE rien : lancer un gestionnaire de paquets pour
# resoudre un arbre reviendrait a executer du code venu du depot analyse.
DEPENDENCY_INVENTORY_ENABLED=true
PROJECT_MAX_DEPENDENCIES=3000

# Comparaison des dependances a une base publique de vulnerabilites.
#
# C'est la SEULE sortie reseau de la securite projet. Ce qui sort se limite
# a un nom de paquet, son ecosysteme et sa version — ce qu'un registre
# public connait deja. Ni chemin, ni identifiant de projet, ni contenu.
#
# A false : l'inventaire continue de fonctionner et l'interface affiche
# « verification desactivee ». JAMAIS « aucune vulnerabilite » : une
# absence de resultat ne doit pas se lire comme un feu vert.
DEPENDENCY_VULNERABILITY_ENABLED=true
# Implementation de VulnerabilityProvider. Seule valeur livree : osv.
VULNERABILITY_PROVIDER=osv
OSV_API_URL=https://api.osv.dev
OSV_TIMEOUT_SECONDS=12
# Au-dela de ces plafonds, le resultat est annonce « partiel » plutot que
# presente comme complet.
OSV_MAX_PACKAGES=1000
OSV_MAX_VULNERABILITY_DETAILS=80
